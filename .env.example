# Copy this file to .env and fill in real values. .env is gitignored - never commit it.
# In Coolify, set these under the application's Environment Variables tab instead of
# relying on a committed .env file - see README.md's "SOW Generator" section.

# Required by the SOW Generator (/sow-generator/) - used server-side only by the
# api container to call the Anthropic Messages API. Never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...
